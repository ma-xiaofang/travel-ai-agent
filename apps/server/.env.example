# ============================================================
# 旅途 AI 旅行规划助手 — 环境变量配置示例
# 复制此文件为 .env 并填入真实值，勿将 .env 提交到版本库
# ============================================================

# ---------- 数据库 (PostgreSQL) ----------
DATABASE_URL="postgresql://用户名:密码@主机:端口/数据库名?schema=public"

# ---------- 大模型 API ----------
# 深度求索（对话模型）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash

# 硅基流动（BGE_M3 向量化，OpenAI 兼容）
SILICON_FLOW_API_KEY=your-silicon-key
# SILICON_FLOW_BASE_URL=https://api.siliconflow.cn/v1

# 智谱（GLM embedding-2 / embedding-3 向量化）
ZHIPU_API_KEY=your-zhipu-key

# ---------- 工具 API ----------
# Tavily 联网搜索
TAVILY_API_KEY=tvly-dev-your-tavily-key

# OpenWeatherMap 实时天气
OPEN_WEATHER_API_KEY=your-openweather-key

# ---------- JWT 认证 ----------
JWT_ACCESS_SECRET=change-me-to-a-random-string
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES_MS=2592000000

# ---------- 可选配置 ----------
PORT=3000
RAG_COLLECTION_NAME=travel-knowledge-base
# 向量模型：embedding-2 / embedding-3（智谱）或 BAAI/bge-m3（硅基流动）
# 含 "bge" 时自动走硅基流动 OpenAI 兼容接口
RAG_EMBEDDING_MODEL=embedding-3
# 向量维度（留空按模型默认：embedding-2=1024、embedding-3=2048、bge-m3=1024）
# RAG_EMBEDDING_DIMENSIONS=2048
# CHAT_TEMPERATURE=0.7
# MAX_ITERATIONS=6
